# Dev server with hot reload:
#   docker build -f Dockerfile.local -t frontend-dev .
#   docker run --rm -p 3000:3000 -v "$PWD":/app -v /app/node_modules -v /app/.next frontend-dev
FROM node:22-alpine
WORKDIR /app
ENV NEXT_TELEMETRY_DISABLED=1 \
    WATCHPACK_POLLING=true
COPY package.json package-lock.json ./
RUN npm ci
COPY . .
EXPOSE 3000
CMD ["npm", "run", "dev", "--", "--hostname", "0.0.0.0", "--port", "3000"]
